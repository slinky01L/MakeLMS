@using MakeLMS.Components.Shared

<div class="soft-card p-2">
     <div class="d-flex justify-content-between align-items-center px-2 py-1">
        <span class="fw-bold small">Course content</span>
        <button type="button" class="btn btn-sm btn-link p-0" style="font-size:.78rem;">+ Add module</button>
    </div>

    @foreach (var module in Modules)
    {
        <div class="module-block">
            <div class="module-head d-flex justify-content-between align-items-center">
                <span><svg class="ic" viewBox="0 0 24 24"><path d="M6 9l6-6 6 6M6 15l6 6 6-6" /></svg> @module.Name</span>
                <button type="button" class="b-icon-btn" title="Remove module" @onclick="() => { }">
                    <svg class="ic" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" /></svg>
                </button>
            </div>
            
            @foreach (var lesson in module.Lessons)
            {
                var isSelected = lesson == SelectedLesson;
                <div class="b-lesson-row @(isSelected ? "selected" : "")" @onclick="() => { }">
                    <LessonTypeIndicator Type="lesson.LessonType" SizePx="24" />
                    <span class="flex-fill small @(isSelected ? "fw-bold" : "")">@lesson.Name</span>
                </div>
            }
            
            <button type="button" class="btn btn-sm btn-link ps-4" style="font-size:.8rem;" @onclick="() => { }">+ Add lesson</button>
        </div>
    }
    
    @if (Modules.Count == 0)
    {
        <div class="text-muted small text-center py-3">No modules yet — add one to get started.</div>
    }
</div>