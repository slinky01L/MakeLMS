@page "/instructor/courses/{id:int}"
@rendermode InteractiveServer

@if (_isLoading)
{
    <p>loading...</p>
}
else if (_course is null)
{
    <p>failed to find course</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <div class="page-title mb-0">@_course.Name</div>
            @* <span class="badge bg-light text-muted border">Draft Status</span> *@
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm">Preview</button>
            <button type="button" class="btn btn-outline-secondary btn-sm">Save draft</button>
            <button type="button" class="btn btn-primary btn-sm">Publish</button>
        </div>
    </div>

    <div class="builder-shell">
        <div class="builder-tree">
            <CourseTree
                Modules="_course.Modules"
                OnAddModule="HandleAddModule"
                OnAddLesson="HandleAddLesson" />
        </div>

        <div class="builder-editor">
        </div>
    </div>
}